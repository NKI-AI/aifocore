"""bzlmod wrapper around the aifocore C++ headers/libraries.

Consumers reference targets as `@aifocore-cpp//:concepts`, `@aifocore-cpp//:ndarray`, etc.
Wired into the aiforoncology monorepo via local_path_override.
"""

module(
    name = "aifocore-cpp",
    version = "0.0.1",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "fmt", version = "12.1.0")
bazel_dep(name = "cereal", version = "1.3.2")
bazel_dep(name = "boost.atomic", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.interprocess", version = "1.90.0.bcr.1")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "openssl", version = "3.3.1.bcr.1")
bazel_dep(name = "xz", version = "5.4.5.bcr.5")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "zstd", version = "1.5.7")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "googletest", version = "1.17.0")

# Vendored BUILD files live under //third_party so the labels resolve inside
# this module without needing access to the parent module's repo namespace.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pybind11",
    build_file = "//third_party:pybind11.BUILD",
    sha256 = "e08cb87f4773da97fa7b5f035de8763abc656d87d5773e62f6da0587d1f0ec20",
    strip_prefix = "pybind11-2.13.6",
    urls = ["https://github.com/pybind/pybind11/archive/refs/tags/v2.13.6.tar.gz"],
)

http_archive(
    name = "minizip",
    build_file = "//third_party:minizip.BUILD",
    sha256 = "c3e9ceab2bec26cb72eba1cf46d0e2c7cad5d2fe3adf5df77e17d6bbfea4ec8f",
    strip_prefix = "minizip-ng-4.0.8",
    urls = ["https://github.com/zlib-ng/minizip-ng/archive/refs/tags/4.0.8.tar.gz"],
)
