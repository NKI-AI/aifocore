    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":ndarray",
        "@pybind11",
    ],
)

cc_library(
    name = "ranges",
    hdrs = ["include/aifocore/ranges/zip.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tiling",
    hdrs = ["include/aifocore/tiling/grid.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":concepts",
        ":ranges",
    ],
