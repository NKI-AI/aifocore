        "include/aifocore/math/ndarray.h",
        "include/aifocore/math/ndarray_all.h",
        "include/aifocore/math/ndarray_functions.h",
        "include/aifocore/math/ndarray_operators.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ndarray_python",
