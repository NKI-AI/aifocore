load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(
    name = "aifocore_headers",
    srcs = glob(["include/**/*.h"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "portability",
    hdrs = ["include/aifocore/platform/portability.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "concepts",
    hdrs = ["include/aifocore/concepts/numeric.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "@fmt",
    ],
)

cc_library(
    name = "concepts_cereal",
    hdrs = ["include/aifocore/concepts/cereal.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":concepts",
        "@cereal",
    ],
)

cc_library(
    name = "math",
    hdrs = ["include/aifocore/concepts/math.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ndarray",
