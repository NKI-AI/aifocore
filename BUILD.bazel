    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "treiber_stack",
    hdrs = ["include/aifocore/utilities/treiber_stack.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "thread_pool_singleton",
    srcs = ["src/utilities/thread_pool_singleton.cpp"],
    hdrs = ["include/aifocore/utilities/thread_pool_singleton.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":bs_thread_pool",
